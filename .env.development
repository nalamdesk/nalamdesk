# NalamDesk — local development port map (committed defaults, no secrets)
# Override locally via .env.local (gitignored) if needed.
#
# Service                          | Variable                      | Port
# ---------------------------------|-------------------------------|------
# Installed desktop local API      | NALAMDESK_DESKTOP_PROD_API_PORT | 3000
# Cloud sync API (CloudSyncService)| NALAMDESK_CLOUD_API_PORT        | 3001
# Desktop dev local API            | NALAMDESK_DESKTOP_DEV_API_PORT  | 3002
# Desktop Angular dev server       | NALAMDESK_DESKTOP_ANGULAR_PORT  | 4200

NALAMDESK_DESKTOP_PROD_API_PORT=3000
NALAMDESK_CLOUD_API_PORT=3001
NALAMDESK_DESKTOP_DEV_API_PORT=3002
NALAMDESK_DESKTOP_ANGULAR_PORT=4200

# Full cloud API URL (desktop CloudSyncService, overrides port-only construction)
CLOUD_API_URL=http://127.0.0.1:3001/api/v1
