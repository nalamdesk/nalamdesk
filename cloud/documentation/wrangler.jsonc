{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-01",
	"name": "nalamdesk-docs",
	"assets": {
		"directory": "./build",
		"not_found_handling": "404-page"
	},
	"routes": [{ "pattern": "docs.nalamdesk.com", "custom_domain": true }],
	"observability": {
		"enabled": true
	}
}
