# Magic headers for Cloudflare Pages.
# Long-cache hashed build assets, never cache HTML.
/_assets/*
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/
  Cache-Control: public, max-age=0, must-revalidate
# Brand assets have stable public URLs (used by partner portals such as the
# ABDM sandbox), so allow cross-origin use and cache for a day, not forever.
/brand/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
